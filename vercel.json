{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(ttf|woff|woff2|svg)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/Codes/(.*)", "destination": "/Codes/$1" },
    { "source": "/", "destination": "/Codes/index.html" },
    { "source": "/clustr", "destination": "/Codes/clustr/index.html" },
    { "source": "/clustr/", "destination": "/Codes/clustr/index.html" },
    { "source": "/agency-page", "destination": "/Codes/detailed-page-html-css/agency-page.html" },
    { "source": "/agency-page/", "destination": "/Codes/detailed-page-html-css/agency-page.html" },
    { "source": "/detailed-page", "destination": "/Codes/detailed-page-html-css/detailed-page.html" },
    { "source": "/detailed-page/", "destination": "/Codes/detailed-page-html-css/detailed-page.html" },
    { "source": "/(.*)", "destination": "/Codes/$1" }
  ]
}

